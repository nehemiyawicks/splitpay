# Public Celo RPC (mainnet)
CELO_RPC_URL=https://forno.celo.org

# WalletConnect project id (get one at https://cloud.reown.com/)
# Composer template shipped this key as NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
# but the code reads NEXT_PUBLIC_WC_PROJECT_ID. Setting both to be safe.
NEXT_PUBLIC_WC_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# SplitPay contract address, set after deploying:
#   cd apps/contracts && pnpm deploy:celo-sepolia
# Copy the deployed address here.
NEXT_PUBLIC_SPLITPAY_ADDRESS=
